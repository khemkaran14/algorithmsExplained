# Local PostgreSQL. Use a unique password; URL-encode special characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://algoverse:replace-with-a-local-password@localhost:5432/algoverse
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Your public origin; register /api/auth/callback/google as the Google OAuth redirect URI.
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend API key and verified sender, required for magic links.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
# Later phases (not consumed by Phase 1):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
