# Local PostgreSQL. Use a unique password; URL-encode special characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://algoverse:replace-with-a-local-password@localhost:5432/algoverse
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Your public origin; register /api/auth/callback/google as the Google OAuth redirect URI.
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend API key and verified sender, required for magic links.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
# Payment provider settings (required only for checkout/webhook testing):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Server-side HMAC secrets must be real values in .env/deployment secrets, not proxy placeholders.
# Use Razorpay TEST keys while validating; no live payment is needed during development.
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET are listed above.
# Secret bearer token for the receipt retry job. Generate using openssl rand -hex 32.
JOBS_SECRET=
# Invoice and public contact details. GST rate is an inclusive percentage, e.g. 18.
BUSINESS_NAME=
BUSINESS_EMAIL=
BUSINESS_GSTIN=
BUSINESS_GST_RATE=0
# Address used by the explicit admin seed command; matching account must already exist.
ADMIN_EMAIL=

# Local standalone preview only. Production requires working Upstash settings above.
RATE_LIMIT_MODE=memory
# Self-hosted only: set if your trusted proxy overwrites it and direct ingress is blocked.
# Vercel uses its platform-owned header automatically. Do not trust raw x-forwarded-for.
TRUSTED_PROXY_IP_HEADER=
