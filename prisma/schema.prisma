generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  role          String           @default("user")
  progress      LessonProgress[]
  quizAttempts  QuizAttempt[]
  bookmarks     Bookmark[]
  notes         Note[]
  streak        Streak?
  xpEvents      XpEvent[]
  badges        UserBadge[]
  certificates  Certificate[]
  flashcards    Flashcard[]
  entitlements  Entitlement[]
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonSlug   String
  status       String    @default("in-progress")
  lastFrame    Int       @default(0)
  timeSpentSec Int       @default(0)
  quizScore    Float     @default(0)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  lessonSlug   String
  answers      Json
  score        Float
  submissionId String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId])
}

model Bookmark {
  id         String @id @default(cuid())
  userId     String
  lessonSlug String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  lessonSlug String
  text       String
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
}

model Streak {
  userId  String  @id
  current Int     @default(0)
  longest Int     @default(0)
  lastDay String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  source    String
  amount    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
}

model Badge {
  id    String      @id @default(cuid())
  code  String      @unique
  name  String
  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Certificate {
  id        String    @id @default(cuid())
  userId    String
  track     String
  issuedAt  DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track])
}

model Flashcard {
  id          String   @id @default(cuid())
  userId      String
  lessonSlug  String
  questionId  String
  interval    Int      @default(0)
  repetitions Int      @default(0)
  ease        Float    @default(2.5)
  due         DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug, questionId])
}

model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("ALL_ACCESS")
  source    String
  paymentId String?   @unique
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment   Payment?  @relation(fields: [paymentId], references: [id])

  @@index([userId, type, revokedAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String?
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  receipt           String        @unique
  amount            Int
  currency          String        @default("INR")
  status            String        @default("created")
  couponId          String?
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
  refundedAt        DateTime?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  entitlement       Entitlement?
  emailReceipt      EmailReceipt?

  @@index([userId, status])
}

model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  kind      String
  value     Int
  expiresAt DateTime
  maxUses   Int
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  payments  Payment[]
}

model EmailReceipt {
  id            String    @id @default(cuid())
  paymentId     String    @unique
  sentAt        DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  payment       Payment   @relation(fields: [paymentId], references: [id])
}
