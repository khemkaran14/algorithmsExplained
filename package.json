{
  "name": "algoverse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "test:lighthouse": "lhci autorun",
    "setup:local": "node scripts/init-local-env.mjs",
    "content:check": "NODE_OPTIONS=--conditions=react-server tsx scripts/content-check.ts",
    "content:generate-catalog": "tsx scripts/generate-catalog.ts",
    "content:free-ratio": "tsx scripts/free-ratio.ts",
    "content:check:ready": "NODE_OPTIONS=--conditions=react-server tsx scripts/content-check.ts --allow-planned",
    "content:generate-index": "tsx scripts/generate-content-index.ts",
    "content:generate-complexity": "NODE_OPTIONS=--conditions=react-server tsx scripts/generate-complexity.mts",
    "content:check:dsa": "NODE_OPTIONS=--conditions=react-server tsx scripts/content-check.ts --track=dsa",
    "content:check:system-design": "NODE_OPTIONS=--conditions=react-server tsx scripts/content-check.ts --track=system-design",
    "content:check:databases": "NODE_OPTIONS=--conditions=react-server tsx scripts/content-check.ts --track=databases",
    "audit:security": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^11.8.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.9.2",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "posthog-js": "^1.438.12",
    "razorpay": "^2.9.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.56.0",
    "@swc/wasm": "1.15.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "prisma": "^6.19.3",
    "prisma-migration-adapter": "npm:@prisma/adapter-pg@7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.28.2 <11"
  },
  "pnpm": {
    "overrides": {
      "@auth/core": "0.41.3",
      "postcss": "8.5.23",
      "deepmerge-ts": "8.0.0",
      "tmp": "0.2.7",
      "basic-ftp": "6.2.1",
      "@puppeteer/browsers": "3.2.5",
      "@next/eslint-plugin-next>fast-glob": "npm:tinyglobby@0.2.17",
      "proxy-agent": "8.0.1",
      "uuid": "11.1.1",
      "@swc/core": "1.15.2",
      "@lhci/utils>js-yaml": "4.3.2"
    },
    "patchedDependencies": {
      "@lhci/utils@0.15.1": "patches/@lhci__utils@0.15.1.patch"
    }
  }
}
